# Where the Parcelwalah backend lives. The portal holds no Firebase credentials
# and no Places key — address search and reverse geocoding go through this API,
# which is what keeps one partner's data out of another partner's browser.
# For local development, use the port from backend/.env (e.g. http://localhost:8000).
NEXT_PUBLIC_API_BASE_URL=https://parcelwalah.in

# Maps JavaScript API key, used only to draw the map and the draggable pin.
#
# This one DOES reach the browser, so before deploying: in Google Cloud, set an
# HTTP-referrer restriction for the portal's domains and an API restriction to
# the Maps JavaScript API. Without the pin the portal still works — pickers fall
# back to address search alone — but captains are then always asked for a pickup
# code, because there is no coordinate to compare their GPS against.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
